{
  // Shared compiler options for every package. Never add include/files here:
  // each package project declares its own. Internal packages resolve through
  // project references; @deepseek-ai/dsh-* dependencies resolve from
  // node_modules.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // The vendored protocol package is the only copy the typert generator can
    // attribute Remote decorators to, so every import resolves through it.
    "paths": {
      "@deepseek-ai/dsh-typert-protocol": ["./packages/typert-protocol/src/index.ts"],
      "@deepseek-ai/dsh-typert-protocol/*": ["./packages/typert-protocol/src/*"]
    }
  }
}
